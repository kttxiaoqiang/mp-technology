/**
 * 知识库 Web 服务
 * - 文件上传（自动分类 + MarkItDown 自动转 md）
 * - 全文搜索（中文分词子词匹配）
 * - 语义搜索（QMD）
 * - 文件列表与下载
 */
const express = require('express');
const multer = require('multer');
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const { autoConvertToMd, toMarkdown, detectCategory } = require('./lib/convert');

const app = express();
const PORT = process.env.PORT || 3344;
const KB_PATH = path.resolve(process.env.KB_PATH || '/home/zhang/company_knowledge_base');

// 缓存头
app.use((req, res, next) => {
  res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
  next();
});

// 静态文件
app.use(express.static(path.join(__dirname, 'public')));
// 原文件下载（通过 /originals/ 路径）
app.use('/originals', express.static(KB_PATH, {
  setHeaders: (res, filePath) => {
    const filename = encodeURIComponent(path.basename(filePath));
    res.setHeader('Content-Disposition', `attachment; filename*=UTF-8''${filename}`);
  }
}));

// 确保 KB 目录存在
if (!fs.existsSync(KB_PATH)) fs.mkdirSync(KB_PATH, { recursive: true });

// ========== 分类目录 ==========
const CATEGORY_DIRS = ['方案', '报告', '密评FAQ', '标准规范', '法规政策', '参考文档'];

function ensureCategoryDirs() {
  for (const dir of CATEGORY_DIRS) {
    const dirPath = path.join(KB_PATH, dir);
    if (!fs.existsSync(dirPath)) fs.mkdirSync(dirPath, { recursive: true });
  }
}

// ========== 将文件移到分类目录 ==========
async function moveToCategory(filePath) {
  const filename = path.basename(filePath);
  const category = detectCategory(filename);
  if (category === '其他') return filePath;

  const destDir = path.join(KB_PATH, category);
  if (!fs.existsSync(destDir)) fs.mkdirSync(destDir, { recursive: true });

  const destPath = path.join(destDir, filename);
  fs.renameSync(filePath, destPath);
  return destPath;
}

// ========== Multer 配置 ==========
const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, KB_PATH),
  filename: (req, file, cb) => {
    let name = file.originalname.replace(/[:\/\\*?"<>|]/g, '_');
    // 修复双重编码乱码
    if (/[\x80-\xff]/.test(name)) {
      try {
        const fixed = Buffer.from(name, 'latin-1').toString('utf-8');
        if (!fixed.includes('\uFFFD')) name = fixed;
      } catch (e) {}
    }
    // 避免文件名冲突
    const filePath = path.join(KB_PATH, name);
    if (fs.existsSync(filePath)) {
      const ext = path.extname(name);
      const base = path.basename(name, ext);
      name = `${base}_${Date.now()}${ext}`;
    }
    cb(null, name);
  }
});

const upload = multer({
  storage,
  limits: { fileSize: 50 * 1024 * 1024 },
  fileFilter: (req, file, cb) => {
    const allowed = /\.(md|txt|docx?|pdf|xlsx?|csv)$/i;
    if (allowed.test(path.extname(file.originalname))) {
      cb(null, true);
    } else {
      cb(new Error(`不支持的文件类型: ${file.originalname}`));
    }
  }
});

// ========== 支持的文件扩展名 ==========
const SUPPORTED_EXT = ['.md', '.txt', '.docx', '.doc', '.pdf', '.xlsx', '.xls', '.csv'];

// ========== 文本提取 ==========
async function extractText(filePath) {
  const ext = path.extname(filePath).toLowerCase();
  try {
    if (ext === '.md' || ext === '.txt' || ext === '.csv') {
      return fs.readFileSync(filePath, 'utf-8').substring(0, 50000);
    }
    // 其他格式用 MarkItDown 提取
    const md = await toMarkdown(filePath);
    return md.substring(0, 50000);
  } catch (e) {
    return `[提取失败: ${e.message}]`;
  }
}

// ========== 中文评分函数 ==========
function scoreFile(content, query) {
  if (content.indexOf(query) !== -1) return 100;

  if (/[\u4e00-\u9fff]/.test(query)) {
    const parts = query.split(/[\s,，、;；：:]+/).filter(t => t.length > 0);
    if (parts.length === 0) return 0;

    let totalScore = 0;
    for (const part of parts) {
      if (content.indexOf(part) !== -1) {
        totalScore += 60;
        continue;
      }
      if (/[\u4e00-\u9fff]/.test(part)) {
        const subTerms = new Set();
        const maxLen = Math.min(4, part.length);
        for (let len = 2; len <= maxLen; len++) {
          for (let i = 0; i + len <= part.length; i++) {
            const sub = part.substring(i, i + len).trim();
            if (sub.length >= 2 && /[\u4e00-\u9fff]/.test(sub)) subTerms.add(sub);
          }
        }
        const enParts = part.split(/[^\u4e00-\u9fff0-9a-zA-Z]/).filter(t => t.length > 0);
        for (const e of enParts) {
          if (/[a-zA-Z0-9]/.test(e)) subTerms.add(e);
        }
        let partMatched = false;
        for (const sub of subTerms) {
          if (content.indexOf(sub) !== -1) {
            totalScore += Math.min(30, sub.length * 5);
            partMatched = true;
          }
        }
        if (!partMatched) totalScore = Math.max(0, totalScore - 20);
      } else {
        totalScore = Math.max(0, totalScore - 20);
      }
    }
    return totalScore;
  }
  return 0;
}

// ========== 解析 QMD 输出 ==========
function parseQmdResults(output) {
  const results = [];
  const lines = output.split('\n');
  let current = {};

  for (const line of lines) {
    const fMatch = line.match(/^File:\s*(.+)$/i);
    if (fMatch) {
      if (current.file) results.push(current);
      current = { file: fMatch[1].trim() };
      continue;
    }
    const sMatch = line.match(/^Score:\s*([\d.]+)/i);
    if (sMatch) {
      current.score = parseFloat(sMatch[1]);
      continue;
    }
    const pMatch = line.match(/^Path:\s*(.+)$/i);
    if (pMatch) {
      current.path = pMatch[1].trim();
      continue;
    }
    const m2 = line.match(/^-\s*\[([\d.]+)\]\s*(.+)$/);
    if (m2) {
      if (current.file) results.push(current);
      current = { score: parseFloat(m2[1]), file: m2[2].trim() };
    }
  }
  if (current.file) results.push(current);
  return results;
}

// ========== 扫描文件（递归） ==========
function scanFiles(baseDir) {
  const result = [];
  let entries;
  try {
    entries = fs.readdirSync(baseDir, { withFileTypes: true });
  } catch (e) {
    return result;
  }

  for (const entry of entries) {
    if (entry.name.startsWith('.')) continue;
    const fullPath = path.join(baseDir, entry.name);

    if (entry.isDirectory()) {
      // 跳过分类目录自身（但进入扫描）
      const subFiles = scanFiles(fullPath);
      result.push(...subFiles);
    } else {
      const ext = path.extname(entry.name).toLowerCase();
      const relPath = fullPath.replace(KB_PATH, '') || '/';
      const dir = path.dirname(relPath).replace(/^\//, '') || null;
      result.push({
        name: entry.name,
        path: relPath.startsWith('/') ? relPath : '/' + relPath,
        fullPath,
        dir
      });
    }
  }

  return result;
}

// ========== API 路由 ==========

// GET /api/files — 列出文件
app.get('/api/files', async (req, res) => {
  try {
    ensureCategoryDirs();
    const allFiles = scanFiles(KB_PATH);
    const supported = allFiles.filter(f => SUPPORTED_EXT.includes(path.extname(f.name).toLowerCase()));

    const filesWithContent = [];
    for (const f of supported) {
      try {
        const content = await extractText(f.fullPath);
        const stat = fs.statSync(f.fullPath);
        filesWithContent.push({
          name: f.name,
          path: f.path,
          dir: f.dir,
          size: stat.size,
          modified: stat.mtime,
          content: content.substring(0, 2000)
        });
      } catch (e) {
        filesWithContent.push({ name: f.name, path: f.path, dir: f.dir, error: e.message });
      }
    }

    res.json({ files: filesWithContent, count: filesWithContent.length });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// GET /api/search — 混合搜索
app.get('/api/search', async (req, res) => {
  const q = (req.query.q || '').trim();
  if (!q) return res.json({ query: q, results: [], count: 0, type: 'hybrid_search' });

  let results = [];

  // 1. QMD 语义搜索
  try {
    const cmd = `qmd query "${q.replace(/"/g, '\\"')}" -c "${KB_PATH}" -n 5 2>/dev/null`;
    const stdout = execSync(cmd, { timeout: 30000, maxBuffer: 5 * 1024 * 1024, shell: '/bin/bash' });
    const qmdResults = parseQmdResults(stdout.toString('utf-8'));

    for (const r of qmdResults) {
      let filePath = r.path || '';
      if (!filePath) {
        const allFiles = scanFiles(KB_PATH);
        const match = allFiles.find(f => f.name === r.file || f.path.endsWith(r.file));
        if (match) filePath = match.fullPath;
      }
      if (!filePath && r.file) filePath = path.join(KB_PATH, r.file);
      // 如果 filePath 没有扩展名，尝试找 .md
      if (filePath && !path.extname(filePath)) {
        const mdPath = filePath + '.md';
        if (fs.existsSync(mdPath)) filePath = mdPath;
      }

      if (filePath && fs.existsSync(filePath)) {
        const content = await extractText(filePath);
        const title = r.file || path.basename(filePath);
        const relPath = filePath.replace(KB_PATH, '') || '/';
        const dir = path.dirname(relPath).replace(/^\//, '') || null;

        results.push({
          title,
          path: relPath,
          dir,
          content: content.substring(0, 500),
          fullContent: content,
          score: r.score || 80,
          method: '语义检索'
        });
      }
    }
  } catch (e) {
    // 语义搜索失败，静默继续
  }

  // 2. 全文补充
  if (results.length < 3) {
    try {
      const allFiles = scanFiles(KB_PATH);
      const supported = allFiles.filter(f => SUPPORTED_EXT.includes(path.extname(f.name).toLowerCase()));
      const existingPaths = new Set(results.map(r => r.path));

      const scored = [];
      for (const f of supported) {
        if (existingPaths.has(f.path)) continue;
        try {
          const content = await extractText(f.fullPath);
          const score = scoreFile(content, q);
          if (score > 0) scored.push({ file: f, score, content });
        } catch (e) {}
      }

      scored.sort((a, b) => b.score - a.score);
      const toTake = Math.min(5, scored.length);
      for (let i = 0; i < toTake; i++) {
        results.push({
          title: scored[i].file.name,
          path: scored[i].file.path,
          dir: scored[i].file.dir,
          content: scored[i].content.substring(0, 500),
          fullContent: scored[i].content,
          score: scored[i].score,
          method: '全文匹配'
        });
      }
    } catch (e) {}
  }

  results.sort((a, b) => (b.score || 0) - (a.score || 0));
  results = results.slice(0, 10);

  res.json({ query: q, results, count: results.length, type: 'hybrid_search' });
});

// GET /api/hybrid-search — 兼容旧端点
app.get('/api/hybrid-search', async (req, res) => {
  const q = (req.query.q || '').trim();
  if (!q) return res.json({ query: q, results: [], count: 0 });

  let results = [];

  try {
    const cmd = `qmd query "${q.replace(/"/g, '\\"')}" -c "${KB_PATH}" -n 5 2>/dev/null`;
    const stdout = execSync(cmd, { timeout: 30000, maxBuffer: 5 * 1024 * 1024, shell: '/bin/bash' });
    const qmdResults = parseQmdResults(stdout.toString('utf-8'));

    for (const r of qmdResults) {
      let filePath = r.path || '';
      if (!filePath) {
        const allFiles = scanFiles(KB_PATH);
        const match = allFiles.find(f => f.name === r.file || f.path.endsWith(r.file));
        if (match) filePath = match.fullPath;
      }
      if (!filePath && r.file) filePath = path.join(KB_PATH, r.file);
      if (filePath && !path.extname(filePath)) {
        const mdPath = filePath + '.md';
        if (fs.existsSync(mdPath)) filePath = mdPath;
      }

      if (filePath && fs.existsSync(filePath)) {
        const content = await extractText(filePath);
        const relPath = filePath.replace(KB_PATH, '') || '/';
        results.push({
          title: r.file || path.basename(filePath),
          path: relPath,
          content: content.substring(0, 500),
          fullContent: content,
          score: r.score || 80,
          method: '语义检索'
        });
      }
    }
  } catch (e) {}

  if (results.length < 3) {
    try {
      const allFiles = scanFiles(KB_PATH);
      const supported = allFiles.filter(f => SUPPORTED_EXT.includes(path.extname(f.name).toLowerCase()));
      const existingPaths = new Set(results.map(r => r.path));

      const scored = [];
      for (const f of supported) {
        if (existingPaths.has(f.path)) continue;
        try {
          const content = await extractText(f.fullPath);
          const score = scoreFile(content, q);
          if (score > 0) scored.push({ file: f, score, content });
        } catch (e) {}
      }

      scored.sort((a, b) => b.score - a.score);
      const toTake = Math.min(5, scored.length);
      for (let i = 0; i < toTake; i++) {
        results.push({
          title: scored[i].file.name,
          path: scored[i].file.path,
          content: scored[i].content.substring(0, 500),
          fullContent: scored[i].content,
          score: scored[i].score,
          method: '全文匹配'
        });
      }
    } catch (e) {}
  }

  results.sort((a, b) => (b.score || 0) - (a.score || 0));
  results = results.slice(0, 10);

  res.json({ query: q, results, count: results.length, type: 'hybrid_search' });
});

// POST /api/upload — 上传文件（单一文件）
app.post('/api/upload', async (req, res) => {
  upload.single('file')(req, res, async (err) => {
    if (err) {
      if (err.code === 'LIMIT_FILE_SIZE') {
        return res.status(413).json({ success: false, error: '文件超过 50MB 限制' });
      }
      return res.status(400).json({ success: false, error: err.message });
    }
    if (!req.file) return res.status(400).json({ success: false, error: '请选择文件' });

    const uploadedPath = req.file.path;
    const result = { success: true, original: req.file.filename, converted: null, category: null };

    try {
      ensureCategoryDirs();

      // 分类
      const movedPath = await moveToCategory(uploadedPath);
      result.category = path.relative(KB_PATH, path.dirname(movedPath));
      if (result.category === '.') result.category = '根目录';

      // 自动转换 MD
      const mdPath = await autoConvertToMd(movedPath);
      if (mdPath) result.converted = path.basename(mdPath);

      console.log(`📥 上传: ${req.file.filename} → ${result.category} ${result.converted ? '✅ 已转 MD' : '(无需转换)'}`);
      res.json(result);
    } catch (e) {
      res.json({ success: true, original: req.file.filename, error: e.message });
    }
  });
});

// POST /api/upload-multiple — 批量上传
app.post('/api/upload-multiple', async (req, res) => {
  upload.array('files', 20)(req, res, async (err) => {
    if (err) return res.status(400).json({ success: false, error: err.message });
    if (!req.files || req.files.length === 0) return res.status(400).json({ success: false, error: '请选择文件' });

    const results = [];
    for (const file of req.files) {
      try {
        ensureCategoryDirs();
        const movedPath = await moveToCategory(file.path);
        let converted = null;
        const mdPath = await autoConvertToMd(movedPath);
        if (mdPath) converted = path.basename(mdPath);
        results.push({
          file: file.filename,
          category: path.relative(KB_PATH, path.dirname(movedPath)),
          converted
        });
      } catch (e) {
        results.push({ file: file.filename, error: e.message });
      }
    }

    console.log(`📥 批量上传 ${results.length} 个文件`);
    res.json({ success: true, results });
  });
});

// GET /api/download/* — 下载原文件
app.get('/api/download/*', (req, res) => {
  const relativePath = req.params[0];
  const fullPath = path.join(KB_PATH, relativePath);
  if (!fs.existsSync(fullPath)) return res.status(404).json({ error: '文件不存在' });
  res.download(fullPath, path.basename(fullPath));
});

// DELETE /api/files/* — 删除文件及对应的 .md
app.delete('/api/files/*', (req, res) => {
  const relativePath = req.params[0];
  const fullPath = path.join(KB_PATH, relativePath);
  if (!fs.existsSync(fullPath)) return res.status(404).json({ error: '文件不存在' });

  const ext = path.extname(fullPath);
  if (ext !== '.md') {
    const baseName = path.basename(fullPath, ext);
    const dir = path.dirname(fullPath);
    const mdPath = path.join(dir, `${baseName}.md`);
    if (fs.existsSync(mdPath)) {
      fs.unlinkSync(mdPath);
      console.log(`  🗑️ 同时删除: ${baseName}.md`);
    }
  }

  fs.unlinkSync(fullPath);
  console.log(`  🗑️ 删除: ${relativePath}`);
  res.json({ success: true, deleted: relativePath });
});

// ========== 启动服务 ==========
ensureCategoryDirs();
app.listen(PORT, '0.0.0.0', () => {
  console.log(`📚 知识库服务已启动`);
  console.log(`   📁 知识库: ${KB_PATH}`);
  console.log(`   🌐 http://localhost:${PORT}`);
  console.log(`   📄 支持格式: .md .txt .docx .doc .pdf .xlsx .xls .csv`);
  console.log(`   🔄 自动转换引擎: MarkItDown`);
});
